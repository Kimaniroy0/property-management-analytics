# Database and Neon Auth (server-side)
DATABASE_URL_POOLED=
DATABASE_URL=
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=

# Neon Auth (browser)
VITE_NEON_AUTH_URL=

# Safaricom Daraja (M-Pesa) — server-side only, never prefix these with VITE_
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_PASSKEY=
DARAJA_SHORTCODE=
# sandbox (default) or production
DARAJA_ENV=sandbox
# Absolute public HTTPS URL that Safaricom can reach, e.g. https://app.example.com/api/mpesa/callback
DARAJA_CALLBACK_URL=
